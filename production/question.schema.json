{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "level",
    "category",
    "question",
    "passage_id",
    "passage",
    "choices",
    "answer",
    "explanation",
    "tags",
    "provenance"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[A-Za-z0-9_-]{3,100}$"
    },
    "level": {
      "enum": [
        "N5",
        "N4",
        "N3",
        "N2",
        "N1"
      ]
    },
    "category": {
      "type": "string"
    },
    "question": {
      "type": "string",
      "minLength": 3
    },
    "passage_id": {
      "type": "string"
    },
    "passage": {
      "type": "string"
    },
    "choices": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "answer": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "explanation": {
      "type": "string",
      "minLength": 8
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "kind",
        "model"
      ],
      "properties": {
        "kind": {
          "const": "original_ai_generation"
        },
        "model": {
          "type": "string"
        }
      }
    }
  }
}
